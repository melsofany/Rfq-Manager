# Copy to .env and fill in the two secrets. Never commit .env.
#
# Required — generate with:  openssl rand -hex 64
SECRET_KEY_BASE=
# Required — any strong password; it protects Chatwoot's own database only.
POSTGRES_PASSWORD=

# Where the console is reachable. Must match the browser URL, or login redirects
# will bounce.
FRONTEND_URL=http://localhost:3000
# Host port for the console UI.
CHATWOOT_PORT=3000

# Set true when serving over HTTPS (production). Leave false for a local stack,
# or the session cookie is marked secure and login fails over plain HTTP.
FORCE_SSL=false

# The Cortoba app the agent clicks through to. It is ALSO the origin allowed to
# embed the console, so it is not merely informational: with framing enabled and
# this unset, the console stays un-embeddable (a blank panel) and the overlay
# keeps X-Frame-Options rather than opening the console to every site.
CORTOBA_APP_URL=https://cortoba-rfq.onrender.com

# Allow the Cortoba app to render this console in an iframe.
#
# Without it Chatwoot's `X-Frame-Options: SAMEORIGIN` makes the browser refuse
# the frame and the panel is BLANK — measured: ERR_BLOCKED_BY_RESPONSE.
# Enabling it swaps that header for a `frame-ancestors` allow-list naming
# CORTOBA_APP_URL (plus CORTOBA_FRAME_ANCESTORS below), which is narrower than
# what it replaces.
#
# Set to 0/false/no/off to keep upstream's protection untouched.
CORTOBA_ALLOW_FRAMING=true

# Extra origins allowed to embed the console, comma-separated. Needed when the
# app answers on more than one host — e.g. a custom domain alongside the
# onrender.com one. An origin missing from this list renders a blank panel with
# no error, so this is the knob to reach for when the embed works on one host
# and not another.
# CORTOBA_FRAME_ANCESTORS=https://app.example.com,https://www.example.com

# ── Private-console gate ─────────────────────────────────────────────────────
#
# The console must answer ONLY the Cortoba gateway, which proxies it same-origin
# under /whatsapp/console. A direct visitor at the service's own address gets a
# bare 404 — no login page, no API.
#
# This exists because infrastructure cannot do it: on the plan this runs on,
# Render's IP allow-list answers "only available for Enterprise workspaces", and
# a service's `type` cannot be changed after creation. So the wall is the
# overlay's own middleware.
#
# LEAVE UNSET to disable the gate (upstream behaviour, the console answers
# directly). Set it — the SAME value on both services — to arm it:
#
#   chatwoot-cortoba : CORTOBA_GATEWAY_SECRET
#   cortoba-rfq      : CHATWOOT_GATEWAY_SECRET
#
# A mismatch strands the console: the gateway would get a 404 instead of the
# console, and the agent would see a blank panel. Set both, then verify:
#
#   curl -s -o /dev/null -w '%{http_code}\n' https://<chatwoot>/app/login   # 404
#   curl -s -o /dev/null -w '%{http_code}\n' https://<gateway>/api/healthz  # 200
#
# Generate one with: openssl rand -hex 32
# CORTOBA_GATEWAY_SECRET=

# Paths that stay public even with the gate armed, comma-separated. These are
# callers that cannot carry our header — Meta delivers the WhatsApp webhook
# straight to Chatwoot, verified by Chatwoot's own signature.
#
# A prefix here is a deliberate hole in the wall, so keep it minimal. The
# built-in exemptions (/health and the webhook roots) are always applied; this
# variable ADDS to them.
# CORTOBA_GATEWAY_PUBLIC_PATHS=

# Conversation custom attribute keys. Must match the bridge's defaults in
# artifacts/api-server/src/modules/chatwoot/client.ts, or the console will not
# render the request/owner fields.
CORTOBA_RFQ_ATTRIBUTE_KEY=cortoba_rfq_no
CORTOBA_OWNER_ATTRIBUTE_KEY=cortoba_owner_name

# debug | info | warn
RAILS_LOG_LEVEL=info
