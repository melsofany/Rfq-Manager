# Copy to .env and fill in the two secrets. Never commit .env.
#
# Required — generate with:  openssl rand -hex 64
SECRET_KEY_BASE=
# Required — any strong password; it protects Chatwoot's own database only.
POSTGRES_PASSWORD=

# Where the console is reachable. Must match the browser URL, or login redirects
# will bounce.
FRONTEND_URL=http://localhost:3000
# Host port for the console UI.
CHATWOOT_PORT=3000

# Set true when serving over HTTPS (production). Leave false for a local stack,
# or the session cookie is marked secure and login fails over plain HTTP.
FORCE_SSL=false

# The Cortoba app the agent clicks through to. Informational only — the console
# never calls it, so it may be left empty.
CORTOBA_APP_URL=

# Conversation custom attribute keys. Must match the bridge's defaults in
# artifacts/api-server/src/modules/chatwoot/client.ts, or the console will not
# render the request/owner fields.
CORTOBA_RFQ_ATTRIBUTE_KEY=cortoba_rfq_no
CORTOBA_OWNER_ATTRIBUTE_KEY=cortoba_owner_name

# debug | info | warn
RAILS_LOG_LEVEL=info
