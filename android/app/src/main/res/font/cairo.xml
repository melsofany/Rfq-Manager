<?xml version="1.0" encoding="utf-8"?>
<!--
  Cairo — the Arabic-first typeface the brand guidelines call for. The three
  weights are bundled (not fetched at runtime) so the app renders identically
  offline, which matters for a field app used without connectivity.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/cairo_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        app:font="@font/cairo_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        app:font="@font/cairo_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
