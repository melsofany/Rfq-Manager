# Chatwoot env — انسخ هذا الملف إلى .env واضبط القيم
# أنشئ SECRET_KEY_BASE عبر: docker run --rm chatwoot/chatwoot:latest rake secret

CHATWOOT_PORT=3000
FRONTEND_URL=https://chatwoot.yourdomain.com
DEFAULT_LOCALE=ar
FORCE_SSL=true

DB_PASSWORD=change_me_strong_postgres_password
SECRET_KEY_BASE=change_me_long_random_string

RAILS_LOG_LEVEL=info

# ── متغيّرات جسر التطبيق (توضع على خدمة cortoba-rfq في Render، لا هنا) ──
# CHATWOOT_URL=https://chatwoot.yourdomain.com
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_API_TOKEN=<user/agent access token>       # للنسخ والردود
# CHATWOOT_INBOX_ID=<رقم قناة API inbox>             # قناة API وليست WhatsApp
# CHATWOOT_PLATFORM_TOKEN=<Platform App token>       # للـ SSO فقط
# CHATWOOT_WEBHOOK_SECRET=<سر عشوائي طويل>

# SMTP (اختياري) — أعد استخدام بيانات Render الحالية لو أردت
SMTP_ADDRESS=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=Chatwoot <noreply@yourdomain.com>
